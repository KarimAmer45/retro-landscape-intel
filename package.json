{
  "name": "retro-landscape-intel",
  "version": "1.0.0",
  "private": true,
  "description": "Evidence-ranked retro games landscape brief built from public source data.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc --outDir dist --noEmit false",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test",
    "ingest": "tsx src/ingest.ts",
    "report": "tsx src/report.ts",
    "refresh": "npm run ingest && npm run report",
    "dashboard": "npm run build && tsx src/serve.ts"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "license": "MIT",
  "author": "Karim Amer",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KarimAmer45/retro-landscape-intel.git"
  },
  "homepage": "https://github.com/KarimAmer45/retro-landscape-intel#readme",
  "bugs": {
    "url": "https://github.com/KarimAmer45/retro-landscape-intel/issues"
  }
}
