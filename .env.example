# Optional overrides. SteamSpy does not require an API key.
# These are read from process.env. No script auto-loads a .env file: export them,
# prefix them on the command line, or run Node with --env-file=.env (see README).
# CLI flags (--tag, --limit, --timeout, --retries) take precedence over these.
STEAMSPY_BASE_URL=https://steamspy.com/api.php
STEAMSPY_TAG=Retro
STEAMSPY_MAX_RECORDS=500
STEAMSPY_TIMEOUT_MS=45000
STEAMSPY_MAX_RETRIES=3
